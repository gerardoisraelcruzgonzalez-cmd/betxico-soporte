# Jira Cloud
JIRA_BASE_URL=https://betxico-cs.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BTF
JIRA_ISSUE_TYPE=Pago a Clientes
JIRA_FIELD_MAP_JSON={}

# Session and encrypted per-agent settings
KV_REST_API_URL=
KV_REST_API_TOKEN=
SUPPORT_SESSION_SECRET=
SUPPORT_ENCRYPTION_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_LIST_ID=
SLACK_LIST_COLUMNS_JSON={}
SLACK_LIST_COLUMN_TYPES_JSON={}
SLACK_ROUTES_JSON=[]
SUPPORT_REMOTE_CONFIG_JSON={}
SUPPORT_ADMIN_EMAILS=

# LiveChat provider and authenticated webhook
LIVECHAT_BASIC_TOKEN=
LIVECHAT_WEBHOOK_SECRET=
LIVECHAT_ORGANIZATION_ID=

# Supervised agent controls. Keep these fail-closed outside a controlled preview.
SUPPORT_AGENT_MODE=suggest
SUPPORT_SLACK_LIST_READS_ENABLED=false
SUPPORT_SLACK_LIST_SYNC_ENABLED=false
SUPPORT_SLACK_SYNC_COOLDOWN_SECONDS=300
SUPPORT_SLACK_SYNC_MAX_ITEMS=500
SUPPORT_LEGACY_AUTO_SAFE_SEND_ENABLED=false

# Private simulator. Real writes also require re-entering the agent PIN,
# the exact confirmation phrase, and an allowlisted target.
SUPPORT_SIMULATOR_ENABLED=false
SUPPORT_SIMULATOR_KNOWLEDGE_ENABLED=false
SUPPORT_SIMULATOR_ALLOWED_EMAILS=gerardo.cruz@betxico.mx
SUPPORT_SIMULATOR_PREVIEW_PIN_HASH=
SUPPORT_SIMULATOR_REAL_ACTIONS_ENABLED=false
SUPPORT_SIMULATOR_JIRA_KEYS=
SUPPORT_SIMULATOR_SLACK_ROUTES=

# AI assistant. Groq is preferred while testing with a free/limited account.
SUPPORT_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_COMPLETION_TOKENS=650
GROQ_JSON_MODE=true

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_REASONING_EFFORT=low
OPENAI_VECTOR_STORE_ID=

# Optional internal guard for direct API calls.
# Do not expose this in public frontend code.
INTERNAL_API_KEY=

# Production should move to LiveChat OAuth/session validation.
ALLOW_UNAUTHENTICATED_WIDGET=false

# Atena read-only LiveChat bridge. Keep the token private.
ATENA_CONNECTOR_TOKEN=
ATENA_BRIDGE_URL=https://support-livechat-app.vercel.app/api/atena-bridge
ATENA_CONNECTOR_LOCK_PORT=8791

# KYC read-only LiveChat bridge. May reuse ATENA_CONNECTOR_TOKEN while
# migrating, but a separate production token is recommended.
KYC_CONNECTOR_TOKEN=
CASE_EVIDENCE_HASH_SECRET=
KYC_BRIDGE_URL=https://support-livechat-app.vercel.app/api/atena-bridge
KYC_CONNECTOR_LOCK_PORT=8792

# Copy this file as .env.agent.local on the operator's Mac.
# Do not commit .env.agent.local and do not send its values by chat or email.
CONNECTOR_AGENT_EMAIL=agent@betxico.mx
ATENA_CONNECTOR_AGENT_TOKEN=replace-with-the-agent-atena-token
KYC_CONNECTOR_AGENT_TOKEN=replace-with-the-agent-kyc-token
BOB_CONNECTOR_AGENT_TOKEN=replace-with-the-agent-bob-token

# Optional. The production bridge is the default.
# ATENA_BRIDGE_URL=https://support-livechat-app.vercel.app/api/atena-bridge
# KYC_BRIDGE_URL=https://support-livechat-app.vercel.app/api/atena-bridge
# BOB_BRIDGE_URL=https://support-livechat-app.vercel.app/api/atena-bridge?service=bob

# Copy to .env.vercel.local and fill secrets locally.
# Do not commit or paste real tokens in chat.

JIRA_BASE_URL=https://betxico-cs.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BTF
JIRA_ISSUE_TYPE=Servicio al Cliente
JIRA_FIELD_MAP_JSON={}
JIRA_REPORTER_NAME=gerardo.cruz
JIRA_REPORTER_ACCOUNT_ID=
JIRA_DEFAULT_ASSIGNEE_NAME=Ivonne Cruz Rodriguez
JIRA_DEFAULT_ASSIGNEE_ACCOUNT_ID=
JIRA_DEFAULT_TEAM_NAME=Betxico - Servicio al Cliente
JIRA_DEFAULT_TEAM_ID=
JIRA_DEFAULT_LABELS=livechat soporte servicio_cliente

# Vercel KV / Upstash Redis for per-agent saved configuration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random secrets. Keep stable across deploys.
SUPPORT_SESSION_SECRET=
SUPPORT_ENCRYPTION_KEY=

SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_USER_SCOPES=chat:write,lists:read
# Must match the Redirect URL configured in the Slack app OAuth settings.
SLACK_USER_OAUTH_CALLBACK_URL=https://support-livechat-app.vercel.app/api/slack-user?action=callback
SLACK_CHANNEL_ID=
SLACK_LIST_ID=
SLACK_LIST_COLUMNS_JSON={}
SLACK_LIST_COLUMN_TYPES_JSON={}
SLACK_ROUTES_JSON=[]
SUPPORT_REMOTE_CONFIG_JSON={}
SUPPORT_ADMIN_EMAILS=

# LiveChat provider and authenticated webhook.
LIVECHAT_BASIC_TOKEN=
LIVECHAT_WEBHOOK_SECRET=
LIVECHAT_ORGANIZATION_ID=

# Supervised agent controls. Enable each capability separately after preview validation.
SUPPORT_AGENT_MODE=suggest
SUPPORT_SLACK_LIST_READS_ENABLED=false
SUPPORT_SLACK_LIST_SYNC_ENABLED=false
SUPPORT_SLACK_SYNC_COOLDOWN_SECONDS=240
SUPPORT_SLACK_SYNC_MAX_ITEMS=1000
SUPPORT_LEGACY_AUTO_SAFE_SEND_ENABLED=false

# Private controlled simulator. Keep real writes off until dedicated test
# destinations have been configured below.
SUPPORT_SIMULATOR_ENABLED=false
SUPPORT_SIMULATOR_KNOWLEDGE_ENABLED=false
SUPPORT_SIMULATOR_ALLOWED_EMAILS=gerardo.cruz@betxico.mx
SUPPORT_SIMULATOR_PREVIEW_PIN_HASH=
SUPPORT_SIMULATOR_REAL_ACTIONS_ENABLED=false
SUPPORT_SIMULATOR_JIRA_KEYS=
SUPPORT_SIMULATOR_SLACK_ROUTES=

# APP Betxico backend: usado por el cierre remoto de sesiones desde LiveChat.
# En nube usa la URL pública del backend y SERVICE_API_TOKEN de APP Betxico.
# En local/desarrollo puedes usar BETXICO_ASSISTANT_LOCAL_TOKEN si el backend corre con LOCAL_BACKEND_TOKEN.
BETXICO_ASSISTANT_API_URL=
BETXICO_ASSISTANT_ACCESS_TOKEN=
BETXICO_ASSISTANT_LOCAL_TOKEN=

# AI assistant. Groq is preferred while testing with a free/limited account.
SUPPORT_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_COMPLETION_TOKENS=650
GROQ_JSON_MODE=true

# Optional OpenAI fallback. Keep the real key only in Vercel/local env files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_REASONING_EFFORT=low
OPENAI_VECTOR_STORE_ID=

# Keep fail-closed. The widget must present a valid support session.
ALLOW_UNAUTHENTICATED_WIDGET=false

# Read-only local connectors. KYC falls back to ATENA_CONNECTOR_TOKEN when its
# dedicated token is not configured.
ATENA_CONNECTOR_TOKEN=
KYC_CONNECTOR_TOKEN=
CASE_EVIDENCE_HASH_SECRET=

# Vercel Cron bearer secret for refreshing the shared Lista 8 and Lista 7 caches.
CRON_SECRET=

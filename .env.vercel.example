# Copy to .env.vercel.local and fill secrets locally.
# Do not commit or paste real tokens in chat.

JIRA_BASE_URL=https://betxico-cs.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BTF
JIRA_ISSUE_TYPE=Servicio al Cliente
JIRA_FIELD_MAP_JSON={}
JIRA_REPORTER_NAME=gerardo.cruz
JIRA_REPORTER_ACCOUNT_ID=
JIRA_DEFAULT_ASSIGNEE_NAME=Ivonne Cruz Rodriguez
JIRA_DEFAULT_ASSIGNEE_ACCOUNT_ID=
JIRA_DEFAULT_TEAM_NAME=Betxico - Servicio al Cliente
JIRA_DEFAULT_TEAM_ID=
JIRA_DEFAULT_LABELS=livechat soporte servicio_cliente

# Vercel KV / Upstash Redis for per-agent saved configuration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random secrets. Keep stable across deploys.
SUPPORT_SESSION_SECRET=
SUPPORT_ENCRYPTION_KEY=

SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_USER_SCOPES=chat:write
# Must match the Redirect URL configured in the Slack app OAuth settings.
SLACK_USER_OAUTH_CALLBACK_URL=https://support-livechat-app.vercel.app/api/slack-user?action=callback
SLACK_CHANNEL_ID=
SLACK_LIST_ID=
SLACK_LIST_COLUMNS_JSON={}
SLACK_LIST_COLUMN_TYPES_JSON={}
SLACK_ROUTES_JSON=[]
SUPPORT_REMOTE_CONFIG_JSON={}
SUPPORT_ADMIN_EMAILS=

# APP Betxico backend: usado por el cierre remoto de sesiones desde LiveChat.
# En nube usa la URL pública del backend y SERVICE_API_TOKEN de APP Betxico.
# En local/desarrollo puedes usar BETXICO_ASSISTANT_LOCAL_TOKEN si el backend corre con LOCAL_BACKEND_TOKEN.
BETXICO_ASSISTANT_API_URL=
BETXICO_ASSISTANT_ACCESS_TOKEN=
BETXICO_ASSISTANT_LOCAL_TOKEN=

# OpenAI assistant. Keep the real key only in Vercel/local env files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_REASONING_EFFORT=low
OPENAI_VECTOR_STORE_ID=

# Keep true while the app is private and installed only in your LiveChat license.
# Move to OAuth/session validation before making this public.
ALLOW_UNAUTHENTICATED_WIDGET=true
